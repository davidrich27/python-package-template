[pytest]
# General pytest configuration options

# Directories to search for tests
testpaths = tests

# File naming patterns for test discovery
python_files = test_*.py *_test.py
python_classes = Test*
python_functions = test_*

# Ignore certain paths during test collection
norecursedirs =
    .git
    .tox
    venv
    dist
    build

# Add command-line options that will be applied every time pytest is run
addopts =
    -v  # Verbose output
    -s  # Print output captured from tests
    -ra  # Show extra test summary info for (a)ll except passed tests
    --doctest-modules  # Run doctests in all modules

# Markers for categorizing tests
markers =
    slow: marks tests as slow (deselect with '-m "not slow"')
    unit: unit tests
    integration: integration tests
    parametrize: parametrized tests

# Configuring warnings
filterwarnings =
    error
    ignore::DeprecationWarning
    ignore::UserWarning

# Timeout settings for long-running tests
timeout = 300  # 5 minutes max per test

# Coverage configuration
# Note: requires pytest-cov plugin
# addopts = --cov=your_package_name --cov-report=term-missing

# Environment variables
; env =
;     PYTHONPATH=.
